# backend 运行镜像：装配式构建。
# tsc/vite 编译在开发机完成（服务器规格有限），这里只 COPY dist；依赖安装
# 独立成层——manifest/schema 不变（含仅新增迁移）时 docker build 直接命中
# 缓存，日常构建秒级。层缓存被 lockfile 变更击穿时，由 BuildKit cache mount
# 里的 pnpm store 兜底：包与供应链校验缓存仍在，重装不再走网络下载。
# 用 debian slim 而非 alpine：typescript 原生二进制对 musl 的支持不稳定
FROM node:24-slim

# 华为云镜像：npmjs 完整只读镜像、integrity 由 lockfile 锁定。09-27 实测本机
# 到 npmmirror CDN 仅 ~280 KB/s、到华为云 5 MB/s+，故默认华为云；服务器直连
# 官方源只有几十 KiB/s
ARG NPM_REGISTRY=https://mirrors.huaweicloud.com/repository/npm/
ENV NPM_CONFIG_REGISTRY=$NPM_REGISTRY
# 与根 package.json packageManager 对齐，保证 lockfile 解析行为一致
RUN npm install -g pnpm@12.4.2

WORKDIR /app

# workspace 骨架：根三件套 + 全部子包 manifest，满足 --frozen-lockfile 的 importer 校验
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/backend/package.json apps/backend/prisma7.config.ts ./apps/backend/
COPY apps/frontend/package.json ./apps/frontend/
COPY packages/request/package.json ./packages/request/
COPY packages/utils/package.json ./packages/utils/
COPY internal/tsconfig/package.json ./internal/tsconfig/

# prisma schema 单独成层（backend postinstall 的 prisma generate 只读 schema，
# 不需要 migrations——迁移目录挪到 install 之后，新增迁移不再击穿依赖层缓存）
COPY apps/backend/prisma/schema.prisma ./apps/backend/prisma/schema.prisma

# prisma7.config.ts import 的零依赖 env 解析模块：install 阶段的 prisma generate
# 经 Prisma CLI loader 加载 config，须与 schema 同层先行（src 其余部分不进运行镜像）
COPY apps/backend/src/configuration/raw-env.ts ./apps/backend/src/configuration/raw-env.ts

# 只装 backend（及其 workspace 依赖）的生产包：frontend 的 echarts/vite、根的
# oxlint/typescript/vitest 等构建工具链全部不进运行镜像。prisma CLI 已在
# backend dependencies（容器启动的 migrate deploy 需要）。
# minimum-release-age=0：lockfile 在开发机已通过供应链校验，装配场景跳过
# 冷校验（逐条拉取包元数据，慢网下要 30s+）；内容完整性仍由 frozen-lockfile
# 的 integrity 锁定。
RUN --mount=type=cache,id=pnpm-store,target=/root/.local/share/pnpm/store \
    pnpm --config.minimum-release-age=0 --registry="$NPM_REGISTRY" install \
        --filter ./apps/backend... --prod --frozen-lockfile

# 迁移目录与 seed 随产物层进镜像（容器启动时 migrate deploy 才读）。
# 目录作为 COPY 源时只复制其内容、不保留目录名——migrations 必须显式
# 指向同名目标目录，否则迁移散落进 prisma/ 根，migrate deploy 静默空跑
COPY apps/backend/prisma/migrations ./apps/backend/prisma/migrations
COPY apps/backend/prisma/seed.ts ./apps/backend/prisma/seed.ts

# 本地已构建产物（dist/generated 里带 prisma client，运行时无需再 generate）
COPY apps/backend/dist ./apps/backend/dist

WORKDIR /app/apps/backend

# 启动即迁移（migrate deploy 幂等：已应用的迁移直接跳过），随后起服务
CMD ["sh", "-c", "./node_modules/.bin/prisma migrate deploy && node dist/main.js"]
