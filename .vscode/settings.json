{
    "files.exclude": {
        "*.tsbuildinfo": true,
        ".zcode": true,
        "apps/backend/tsconfig.build.tsbuildinfo": true
    },
    "explorer.fileNesting.enabled": true, // 启用文件嵌套功能
    "explorer.fileNesting.expand": false, // 默认折叠嵌套文件（不展开）
    "explorer.fileNesting.patterns": {
        "package.json": "pnpm-lock.yaml,tsconfig.json, .gitignore, .gitattributes,pnpm-workspace.yaml ,README.md",
        ".oxlintrc.json": ".oxfmtrc.json,.oxlintrc.staged.json ,lefthook.yml",
        "AGENTS.md": "CLAUDE.md"
    }
}
