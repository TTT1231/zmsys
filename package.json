        "oxlint-tsgolint": "catalog:",
        "tsdown": "catalog:",
        "tsx": "catalog:",
        "typescript": "catalog:",
        "vitest": "catalog:"
    },
    "engines": {
        "node": ">=24"
    },
    "packageManager": "pnpm@12.4.2"
}
