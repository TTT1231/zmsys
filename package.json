{
    "name": "zmsys",
    "version": "1.0.0",
    "private": true,
    "description": "",
    "keywords": [],
    "license": "ISC",
    "author": "",
    "type": "module",
    "scripts": {
        "postinstall": "pnpm -r run --if-present stub",
        "dev": "pnpm --parallel --filter ./apps/frontend --filter ./apps/backend run dev",
        "dev:frontend": "pnpm --filter ./apps/frontend dev",
        "dev:backend": "pnpm --filter ./apps/backend dev",
        "typecheck": "tsx scripts/run-typecheck.ts",
        "lint": "tsx scripts/run-oxlint.ts && tsx scripts/theme-guard.ts",
        "format": "oxfmt .",
        "test": "pnpm -r --if-present run test",
        "test:db:reset": "tsx scripts/reset-test-db.ts",
        "test:e2e": "pnpm test:db:reset && pnpm --filter ./apps/backend exec vitest run --config ./vitest.config.e2e.mts",
        "smoke": "tsx scripts/smoke.ts",
        "backup-database": "tsx scripts/backup-database.ts",
        "restore-database": "tsx scripts/restore-database.ts",
        "restore-drill": "tsx scripts/restore-drill.ts",
        "deploy:prod": "tsx scripts/deploy/deploy.ts"
    },
    "devDependencies": {
        "@types/node": "catalog:",
        "@zmsys/tsconfig": "workspace:*",
        "dotenv": "^17.4.2",
        "lefthook": "catalog:",
        "mariadb": "3.4.5",
        "oxfmt": "catalog:",
        "oxlint": "catalog:",
        "oxlint-tsgolint": "catalog:",
        "tsdown": "catalog:",
        "tsx": "catalog:",
        "typescript": "catalog:",
        "vitest": "catalog:"
    },
    "engines": {
        "node": ">=24"
    },
    "packageManager": "pnpm@12.4.2"
}
