        {
            "path": "/bom-stocks/{code}/ledger",
            "title": "库存流水",
            "permissions": ["bom:view"],
            "pathParams": ["code"],
            "tool": {
                "type": "function",
                "function": {
                    "name": "getBomStockLedger",
                    "description": "BOM 出入库流水与逐笔结余。权限 `bom:view`。入库仅展示有效（ACTIVE）单，库存调整全部展示；出库展示全部单据的全部事件，作废单的正向与冲销行成对出现（冲销行备注展示作废原因），按业务日升序计算逐笔结余。`stockQty` 与末笔 `balance` 及 v_bom_stock 恒等。BOM 不存在返回 404；存在但无有效流水返回空 flows 与 stockQty 0。",
                    "parameters": {
                        "type": "object",
                        "properties": {
                            "code": {
                                "type": "string",
                                "pattern": "^(XK3W|XK3P|XK2|XK3|KWO|KW|AQ|KD|KQ)[0-9]{3,}$",
                                "description": "品类前缀 + 至少 3 位序号，前缀 XK2/XK3/KW/KWO/AQ/KD/KQ/XK3W/XK3P，如 XK2001、KW001、KWO001、AQ001、KD001、KQ001"
                            }
                        },
                        "required": ["code"],
                        "additionalProperties": false
                    }
                }
            }
        },
