{
    "name": "admin-manage",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc -b && vite build",
        "lint": "oxlint",
        "format": "oxfmt src mocks scripts *.ts *.json *.md",
        "test": "node --test scripts/inventory.test.mjs",
        "preview": "vite preview",
        "prepare": "husky"
    },
    "dependencies": {
        "@tanstack/react-query": "^5.102.8",
        "axios": "^1.20.0",
        "echarts": "^6.1.0",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "react-router": "^8.3.1"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.3.3",
        "@types/node": "^26.4.1",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.7",
        "@vitejs/plugin-react": "^6.1.1",
        "husky": "^9.1.7",
        "lint-staged": "^17.5.0",
        "msw": "^2.15.0",
        "oxfmt": "^0.66.0",
        "oxlint": "^1.81.0",
        "tailwindcss": "^4.3.3",
        "typescript": "~7.0.2",
        "vite": "^8.2.2"
    },
    "lint-staged": {
        "*.{js,jsx,ts,tsx,mjs,cjs}": [
            "oxlint --fix",
            "oxfmt"
        ],
        "*.{json,md}": [
            "oxfmt"
        ]
    },
    "msw": {
        "workerDirectory": [
            "public"
        ]
    }
}
