// 数据库约束的权威来源是 docs/mysql-8-schema.sql（基线建表脚本）。
// Prisma 模型只负责客户端类型映射；迁移 SQL 手写，保留基线的
// CHECK 约束、ascii_bin 字符集与 ON UPDATE 等数据库层约束。
//
// created_at 一律由应用显式写入（new Date()，Node 时钟），不标 @default(now())：
// @default(now()) 会映射到 DB 端 DEFAULT CURRENT_TIMESTAMP，其取值依赖服务器
// 会话时区——实测本机 MySQL（Windows 中文系统时区名无法解析，system_time_zone
// 为乱码）NOW() 与 UTC_TIMESTAMP() 相互矛盾，服务器时间函数不可信。
// DDL 中的 DEFAULT 仅作手工 SQL 兜底保留。

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["views"]
}

datasource db {
  provider = "mysql"
}

/// sys_grant.grant_source：初始播种行 vs 界面修改行（见 db-scheme.md §3.3）
enum GrantSource {
  BOOTSTRAP
  USER
}

/// sys_permission.kind：菜单码 `menu:<menuKey>` 或动作码 `<menuKey>:<actionId>`
enum PermissionKind {
  MENU
  ACTION
}

/// sys_user_change_log.event_type
enum UserChangeEventType {
  CREATE
  PROFILE_UPDATE
  ROLE_CHANGE
  STATUS_CHANGE
  PASSWORD_CHANGE
  PASSWORD_RESET
}

/// api_idempotency.state：占位与业务写入同事务，成功后转 SUCCEEDED 供重放（见 db-scheme.md §1.3）
enum ApiIdempotencyState {
  PROCESSING
  SUCCEEDED
}

/// sales_order_table.lifecycle_status：活动订单、已取消订单与已归档订单（归档为最终终态）
enum SalesOrderLifecycleStatus {
  ACTIVE
  CANCELLED
  ARCHIVED
}

/// sales_order_change_log.event_type
enum SalesOrderChangeEventType {
  CREATE
  UPDATE
  CANCEL
  ARCHIVE
}

/// inbound_ledger.status：有效台账与当天作废
enum InboundStatus {
  ACTIVE
  VOIDED
}

/// inbound_change_log.event_type
enum InboundChangeEventType {
  UPDATE
  VOID
}

/// outbound_shipment.state：两态（打印为纯输出动作，不再是状态）
enum OutboundShipmentState {
  REGISTERED
  VOIDED
}

/// outbound_state_log.before|after_state：PRINTED 仅为迁移前存量日志保留，代码不再写入
enum OutboundStateLogState {
  REGISTERED
  PRINTED
  VOIDED
}

/// outbound_ledger.entry_type：正常发货 vs 冲销
enum OutboundEntryType {
  NORMAL
  CORRECTION
}

/// outbound_state_log.event_type：PRINT/REPRINT/VOID_PRE_PRINT/VOID_EMERGENCY 为存量历史值，
/// 新代码只写 REGISTER/VOID，勿清理（收缩枚举会炸存量行）
enum OutboundStateEventType {
  REGISTER
  PRINT
  REPRINT
  VOID_PRE_PRINT
  VOID_EMERGENCY
  VOID
}

/// material_group.kind：分区（纯展示树节点，不挂物料）与分组（可选物料叶子）
enum MaterialGroupKind {
  SECTION
  GROUP
}

/// op_log.action：业务里程碑动作，一个 (action, target_id) 只记一次（uk 兜底）
enum OpLogAction {
  ship
  create_customer
  create_order
  delete_bom
  delete_order
  archive_order
}

/// 固定角色目录；grant_version 是整组授权的乐观锁版本
model SysRole {
  code         String     @id @db.VarChar(20)
  name         String     @unique @db.VarChar(32)
  locked       Boolean    @default(false)
  grantVersion BigInt     @default(1) @map("grant_version") @db.UnsignedBigInt
  createdAt    DateTime   @map("created_at") @db.DateTime(3)
  updatedAt    DateTime   @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)
  users        SysUser[]
  grants       SysGrant[]

  @@map("sys_role")
}

/// 系统用户；id 为应用层 Snowflake 主键，token_version 控制旧 JWT 失效
model SysUser {
  id                 BigInt             @id
  account            String             @unique @db.VarChar(64)
  passwordHash       String             @map("password_hash") @db.VarChar(255)
  name               String             @db.VarChar(64)
  roleCode           String             @map("role_code") @db.VarChar(20)
  status             Boolean            @default(true)
  tokenVersion       BigInt             @default(1) @map("token_version") @db.UnsignedBigInt
  rowVersion         BigInt             @default(1) @map("row_version") @db.UnsignedBigInt
  passwordChangedAt  DateTime?          @map("password_changed_at") @db.DateTime(3)
  lastLoginAt        DateTime?          @map("last_login_at") @db.DateTime(3)
  createdAt          DateTime           @map("created_at") @db.DateTime(3)
  updatedAt          DateTime           @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)
  role               SysRole               @relation(fields: [roleCode], references: [code])
  changeLogs         SysUserChangeLog[]    @relation("SysUserChangeLogUser")
  operatedLogs       SysUserChangeLog[]    @relation("SysUserChangeLogOperator")
  idempotencyRecords ApiIdempotency[]
  bomCreated         BomTable[]            @relation("BomCreator")
  bomUpdated         BomTable[]            @relation("BomUpdater")
  ownedCustomers     CustomTable[]         @relation("CustomerOwner")
  customerCreated    CustomTable[]         @relation("CustomerCreator")
  customerUpdated    CustomTable[]         @relation("CustomerUpdater")
  ownerHistoryFrom      CustomerOwnerHistory[] @relation("OwnerHistoryFrom")
  ownerHistoryTo        CustomerOwnerHistory[] @relation("OwnerHistoryTo")
  ownerHistoryOperator  CustomerOwnerHistory[] @relation("OwnerHistoryOperator")
  cancelledOrders       SalesOrderTable[]      @relation("SalesOrderCanceller")
  archivedOrders        SalesOrderTable[]      @relation("SalesOrderArchiver")
  createdOrders         SalesOrderTable[]      @relation("SalesOrderCreator")
  updatedOrders         SalesOrderTable[]      @relation("SalesOrderUpdater")
  orderChangeLogs       SalesOrderChangeLog[]
  operatedInbound       InboundLedger[]        @relation("InboundOperator")
  updatedInbound        InboundLedger[]        @relation("InboundUpdater")
  inboundChangeLogs     InboundChangeLog[]     @relation("InboundChangeOperator")
  operatedAdjustments   StockAdjustment[]      @relation("StockAdjustmentOperator")
  registeredShipments   OutboundShipment[]     @relation("OutboundRegistrar")
  voidedShipments       OutboundShipment[]     @relation("OutboundVoider")
  outboundLedgerEntries OutboundLedger[]       @relation("OutboundLedgerOperator")
  outboundStateLogs     OutboundStateLog[]     @relation("OutboundStateOperator")
  opLogs                OpLog[]                @relation("OpLogOperator")

  @@index([roleCode, status])
  @@map("sys_user")
}

/// 权限目录由后端维护；protected=1 的权限只允许 super 持有
model SysPermission {
  code        String         @id @db.VarChar(80)
  kind        PermissionKind
  menuKey     String         @map("menu_key") @db.VarChar(40)
  actionId    String?        @map("action_id") @db.VarChar(40)
  label       String         @db.VarChar(64)
  isProtected Boolean        @default(false) @map("protected")
  createdAt   DateTime       @map("created_at") @db.DateTime(3)
  grants      SysGrant[]

  @@unique([kind, menuKey, actionId])
  @@map("sys_permission")
}

/// 角色授权；(role_code, permission_code) 为主键，整组替换式保存
model SysGrant {
  roleCode       String        @map("role_code") @db.VarChar(20)
  permissionCode String        @map("permission_code") @db.VarChar(80)
  grantSource    GrantSource   @default(USER) @map("grant_source")
  grantedBy      BigInt?       @map("granted_by")
  grantedAt      DateTime      @map("granted_at") @db.DateTime(3)
  role           SysRole       @relation(fields: [roleCode], references: [code])
  permission     SysPermission @relation(fields: [permissionCode], references: [code])

  @@id([roleCode, permissionCode])
  @@index([permissionCode])
  @@index([grantedBy])
  @@map("sys_grant")
}

/// 授权变更日志：no-op 保存也要记录，版本不递增时 after_version == before_version
model SysGrantLog {
  id            BigInt   @id
  operatorId    BigInt   @map("operator_id")
  roleCode      String   @map("role_code") @db.VarChar(20)
  beforeVersion BigInt   @map("before_version") @db.UnsignedBigInt
  afterVersion  BigInt   @map("after_version") @db.UnsignedBigInt
  serverNote    String   @map("server_note") @db.VarChar(1000)
  clientReason  String   @default("") @map("client_reason") @db.VarChar(500)
  beforeJson    Json     @map("before_json")
  afterJson     Json     @map("after_json")
  createdAt     DateTime @map("created_at") @db.DateTime(3)

  @@index([roleCode, createdAt(sort: Desc)])
  @@index([operatorId, createdAt(sort: Desc)])
  @@map("sys_grant_log")
}

/// 用户变更日志：快照不得包含密码哈希（数据库 CHECK 兜底）
model SysUserChangeLog {
  id            BigInt              @id
  userId        BigInt              @map("user_id")
  operatorId    BigInt              @map("operator_id")
  eventType     UserChangeEventType @map("event_type")
  beforeVersion BigInt?             @map("before_version") @db.UnsignedBigInt
  afterVersion  BigInt              @map("after_version") @db.UnsignedBigInt
  reason        String              @default("") @db.VarChar(500)
  beforeJson    Json?               @map("before_json")
  afterJson     Json                @map("after_json")
  createdAt     DateTime            @map("created_at") @db.DateTime(3)
  user          SysUser             @relation("SysUserChangeLogUser", fields: [userId], references: [id])
  operator      SysUser             @relation("SysUserChangeLogOperator", fields: [operatorId], references: [id])

  @@index([userId, createdAt(sort: Desc)])
  @@index([operatorId, createdAt(sort: Desc)])
  @@map("sys_user_change_log")
}

/// 幂等记录：(actor_id, operation_key, idempotency_key) 唯一（db-scheme.md §1.3）：
/// 同 key 异摘要 409，同 key 成功后重放 response_json；占位与业务写入同事务
model ApiIdempotency {
  id             BigInt              @id
  actorId        BigInt              @map("actor_id")
  operationKey   String              @map("operation_key") @db.VarChar(120)
  idempotencyKey String              @map("idempotency_key") @db.VarChar(128)
  requestHash    Bytes               @map("request_hash") @db.Binary(32)
  state          ApiIdempotencyState @default(PROCESSING)
  httpStatus     Int?                @map("http_status") @db.UnsignedSmallInt
  responseJson   Json?               @map("response_json")
  resourceType   String?             @map("resource_type") @db.VarChar(40)
  resourceCode   String?             @map("resource_code") @db.VarChar(64)
  createdAt      DateTime            @map("created_at") @db.DateTime(3)
  updatedAt      DateTime            @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)
  expiresAt      DateTime            @map("expires_at") @db.DateTime(3)
  actor          SysUser             @relation(fields: [actorId], references: [id])

  @@unique([actorId, operationKey, idempotencyKey], map: "uk_api_idempotency_request")
  @@index([expiresAt], map: "idx_api_idempotency_expiry")
  @@map("api_idempotency")
}

/// 业务编号序列：事务内 SELECT ... FOR UPDATE 递增取号，禁止 MAX+1（db-scheme.md §1.3）
model BizSequence {
  sequenceKey String   @id @map("sequence_key") @db.VarChar(80)
  nextValue   BigInt   @map("next_value") @db.UnsignedBigInt
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)

  @@map("biz_sequence")
}

/// BOM 品类目录：1–9999 为内置参考数据保留 id（种子 1001-1006）；
/// child_categories 标记该品类建档必须选择列表内品类的某个 BOM 作为子件（如跌倒开关嵌入微动开关）
model BomCategory {
  id          BigInt   @id
  categoryKey String   @unique(map: "uk_bom_category_key") @map("category_key") @db.VarChar(40)
  name        String   @unique(map: "uk_bom_category_name") @db.VarChar(64)
  codePrefix  String   @unique(map: "uk_bom_category_prefix") @map("code_prefix") @db.VarChar(16)
  seqWidth    Int      @default(3) @map("seq_width") @db.UnsignedTinyInt
  childCategories Json? @map("child_categories")
  status      Boolean  @default(true)
  rowVersion  BigInt   @default(1) @map("row_version") @db.UnsignedBigInt
  createdAt   DateTime @map("created_at") @db.DateTime(3)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)
  boms        BomTable[]
  groups      MaterialGroup[]

  @@map("bom_category")
}

/// 物料目录节点：分区（SECTION，仅展示与折叠）或分组（GROUP，挂可选物料）；
/// 分组 key 为稳定标识（如 model），qty=1 的分组勾选后可选数量（如扣板/静片），
/// 目录修改只走迁移（db-scheme.md §5）
model MaterialGroup {
  id        BigInt           @id
  categoryId BigInt          @map("category_id")
  parentId  BigInt?          @map("parent_id")
  kind      MaterialGroupKind
  name      String           @db.VarChar(64)
  groupKey  String?          @map("group_key") @db.VarChar(40)
  multi     Boolean?
  qty       Boolean?
  sortOrder Int              @default(0) @map("sort_order") @db.UnsignedSmallInt
  status    Boolean          @default(true)
  createdAt DateTime         @map("created_at") @db.DateTime(3)
  updatedAt DateTime         @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)
  category  BomCategory       @relation(fields: [categoryId], references: [id])
  parent    MaterialGroup?    @relation("MaterialGroupTree", fields: [parentId], references: [id])
  children  MaterialGroup[]   @relation("MaterialGroupTree")
  items     MaterialItem[]

  @@unique([categoryId, name], map: "uk_material_group_name")
  @@unique([categoryId, groupKey], map: "uk_material_group_key")
  @@index([categoryId, status], map: "idx_material_group_category_status")
  @@map("material_group")
}

/// 可选物料项：建档时冻结名称到 bom_item，此处改名/停用不影响已建 BOM；
/// 已被引用的物料不得改名、移组或复用 id（规格变化 = 新增项 + 旧项停用）
model MaterialItem {
  id        BigInt   @id
  groupId   BigInt   @map("group_id")
  name      String   @db.VarChar(64)
  sortOrder Int      @default(0) @map("sort_order") @db.UnsignedSmallInt
  status    Boolean  @default(true)
  createdAt DateTime @map("created_at") @db.DateTime(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)
  group     MaterialGroup @relation(fields: [groupId], references: [id])
  bomItems  BomItem[]

  @@unique([groupId, name], map: "uk_material_item_name")
  @@index([groupId, status], map: "idx_material_item_group_status")
  @@map("material_item")
}

/// BOM 物料：(category_id, spec_hash) 业务去重；spec_hash 为选中物料 id 集合
/// （BigInt 十进制规范化、去重、数值升序 JSON 数组）的 SHA-256。
/// 跌倒开关等品类通过 child_categories 标记合并子品类目录，物料统一走勾选，不引用 BOM。
model BomTable {
  id          BigInt   @id
  bomCode     String   @unique(map: "uk_bom_code") @map("bom_code") @db.VarChar(32)
  categoryId  BigInt   @map("category_id")
  specHash    Bytes    @map("spec_hash") @db.Binary(32)
  /// 建档备注（工艺差异，参与判重指纹）：同构成不同备注 = 不同 BOM；空串 = 无备注
  remark      String   @default("") @map("remark") @db.Text
  unit        String   @default("个") @db.VarChar(16)
  status      Boolean  @default(true)
  rowVersion  BigInt   @default(1) @map("row_version") @db.UnsignedBigInt
  requestKey  String   @unique(map: "uk_bom_request") @map("request_key") @db.VarChar(128)
  createdBy   BigInt   @map("created_by")
  updatedBy   BigInt   @map("updated_by")
  createdAt   DateTime @map("created_at") @db.DateTime(3)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)
  category    BomCategory @relation(fields: [categoryId], references: [id])
  creator     SysUser     @relation("BomCreator", fields: [createdBy], references: [id])
  updater     SysUser     @relation("BomUpdater", fields: [updatedBy], references: [id])
  orders      SalesOrderTable[]
  inboundEntries InboundLedger[]
  adjustments StockAdjustment[]
  items       BomItem[]

  @@unique([categoryId, specHash], map: "uk_bom_identity")
  @@index([categoryId, status], map: "idx_bom_category_status")
  @@map("bom_table")
}

/// BOM 明细行：建档时冻结 groupKey/groupName/name/position 与数量（qty 分组
/// 1-99，其余恒 1），展示与摘要（“组名：物料名 ×N”按 position 排序）完全不依赖当前目录
model BomItem {
  id         BigInt   @id
  bomId      BigInt   @map("bom_id")
  materialId BigInt   @map("material_id")
  groupKey   String   @map("group_key") @db.VarChar(40)
  groupName  String   @map("group_name") @db.VarChar(64)
  name       String   @db.VarChar(64)
  position   Int      @db.UnsignedInt
  quantity   Int      @default(1) @db.UnsignedInt
  createdAt  DateTime @map("created_at") @db.DateTime(3)
  bom        BomTable     @relation(fields: [bomId], references: [id])
  material   MaterialItem @relation(fields: [materialId], references: [id])

  @@unique([bomId, materialId], map: "uk_bom_item_once")
  @@index([materialId], map: "idx_bom_item_material")
  @@map("bom_item")
}

/// 客户档案：customer_code 形如 CUS-0001；owner_id 为负责销售
model CustomTable {
  id             BigInt   @id
  customerCode   String   @unique(map: "uk_customer_code") @map("customer_code") @db.VarChar(24)
  name           String   @db.VarChar(160)
  contactPerson  String   @map("contact_person") @db.VarChar(64)
  contactPhone   String   @map("contact_phone") @db.VarChar(32)
  province       String?  @db.VarChar(64)
  city           String?  @db.VarChar(64)
  district       String?  @db.VarChar(64)
  town           String?  @db.VarChar(96)
  address        String?  @db.VarChar(300)
  ownerId        BigInt   @map("owner_id")
  payTerms       String   @default("") @map("pay_terms") @db.VarChar(160)
  rowVersion     BigInt   @default(1) @map("row_version") @db.UnsignedBigInt
  requestKey     String   @unique(map: "uk_customer_request") @map("request_key") @db.VarChar(128)
  createdBy      BigInt   @map("created_by")
  updatedBy      BigInt   @map("updated_by")
  createdAt      DateTime @map("created_at") @db.DateTime(3)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)
  owner          SysUser                @relation("CustomerOwner", fields: [ownerId], references: [id])
  creator        SysUser                @relation("CustomerCreator", fields: [createdBy], references: [id])
  updater        SysUser                @relation("CustomerUpdater", fields: [updatedBy], references: [id])
  orders         SalesOrderTable[]
  ownerHistory   CustomerOwnerHistory[]

  @@index([ownerId], map: "idx_customer_owner")
  @@index([name], map: "idx_customer_name")
  @@map("custom_table")
}

/// 客户负责人移交历史：batch_id 标识一次批量移交
model CustomerOwnerHistory {
  id          BigInt   @id
  batchId     BigInt   @map("batch_id")
  customerId  BigInt   @map("customer_id")
  fromOwnerId BigInt   @map("from_owner_id")
  toOwnerId   BigInt   @map("to_owner_id")
  operatorId  BigInt   @map("operator_id")
  reason      String   @db.VarChar(500)
  createdAt   DateTime @map("created_at") @db.DateTime(3)
  customer    CustomTable @relation(fields: [customerId], references: [id])
  fromOwner   SysUser     @relation("OwnerHistoryFrom", fields: [fromOwnerId], references: [id])
  toOwner     SysUser     @relation("OwnerHistoryTo", fields: [toOwnerId], references: [id])
  operator    SysUser     @relation("OwnerHistoryOperator", fields: [operatorId], references: [id])

  @@unique([batchId, customerId], map: "uk_customer_owner_history_batch_customer")
  @@index([customerId, createdAt(sort: Desc)], map: "idx_customer_owner_history_customer_time")
  @@index([fromOwnerId, createdAt(sort: Desc)], map: "idx_customer_owner_history_from_time")
  @@map("customer_owner_history")
}

/// 销售订单：下单即冻结客户/BOM 快照；取消为生命周期终态，不物理删除
model SalesOrderTable {
  id                  BigInt                     @id
  orderNo             String                     @unique(map: "uk_sales_order_no") @map("order_no") @db.VarChar(24)
  customerId          BigInt                     @map("customer_id")
  bomId               BigInt                     @map("bom_id")
  qty                 Int                        @db.UnsignedInt
  lifecycleStatus     SalesOrderLifecycleStatus  @default(ACTIVE) @map("lifecycle_status")
  orderDate           DateTime                   @map("order_date") @db.Date
  deliverDate         DateTime                   @map("deliver_date") @db.Date
  remark              String                     @db.Text
  customerNameSnapshot String                    @map("customer_name_snapshot") @db.VarChar(160)
  bomNameSnapshot     String                     @map("bom_name_snapshot") @db.VarChar(64)
  bomModelSnapshot    String                     @map("bom_model_snapshot") @db.VarChar(64)
  bomSpecSnapshot     Json                       @map("bom_spec_snapshot")
  cancelledAt         DateTime?                  @map("cancelled_at") @db.DateTime(3)
  cancelledBy         BigInt?                    @map("cancelled_by")
  cancelReason        String?                    @map("cancel_reason") @db.VarChar(500)
  archivedAt          DateTime?                  @map("archived_at") @db.DateTime(3)
  archivedBy          BigInt?                    @map("archived_by")
  archiveReason       String?                    @map("archive_reason") @db.VarChar(500)
  rowVersion          BigInt                     @default(1) @map("row_version") @db.UnsignedBigInt
  requestKey          String                     @unique(map: "uk_sales_order_request") @map("request_key") @db.VarChar(128)
  createdBy           BigInt                     @map("created_by")
  updatedBy           BigInt                     @map("updated_by")
  createdAt           DateTime                   @map("created_at") @db.DateTime(3)
  updatedAt           DateTime                   @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)
  customer            CustomTable                @relation(fields: [customerId], references: [id])
  bom                 BomTable                   @relation(fields: [bomId], references: [id])
  canceller           SysUser?                   @relation("SalesOrderCanceller", fields: [cancelledBy], references: [id])
  archiver            SysUser?                   @relation("SalesOrderArchiver", fields: [archivedBy], references: [id])
  creator             SysUser                    @relation("SalesOrderCreator", fields: [createdBy], references: [id])
  updater             SysUser                    @relation("SalesOrderUpdater", fields: [updatedBy], references: [id])
  shipments           OutboundShipment[]
  changeLogs          SalesOrderChangeLog[]

  @@index([bomId, lifecycleStatus, deliverDate, orderNo], map: "idx_sales_order_bom_queue")
  @@index([customerId, orderDate], map: "idx_sales_order_customer_date")
  @@map("sales_order_table")
}

/// 订单变更日志：CREATE/CANCEL 必带 request_key（幂等键回写业务行）
model SalesOrderChangeLog {
  id             BigInt                    @id
  orderId        BigInt                    @map("order_id")
  operatorId     BigInt                    @map("operator_id")
  eventType      SalesOrderChangeEventType @map("event_type")
  beforeVersion  BigInt?                   @map("before_version") @db.UnsignedBigInt
  afterVersion   BigInt                    @map("after_version") @db.UnsignedBigInt
  reason         String                    @default("") @db.VarChar(500)
  requestKey     String?                   @unique(map: "uk_sales_order_change_request") @map("request_key") @db.VarChar(128)
  beforeJson     Json?                     @map("before_json")
  afterJson      Json                      @map("after_json")
  createdAt      DateTime                  @map("created_at") @db.DateTime(3)
  order          SalesOrderTable @relation(fields: [orderId], references: [id])
  operator       SysUser         @relation(fields: [operatorId], references: [id])

  @@index([orderId, createdAt(sort: Desc)], map: "idx_sales_order_change_order_time")
  @@index([operatorId, createdAt(sort: Desc)], map: "idx_sales_order_change_operator_time")
  @@map("sales_order_change_log")
}

/// 成品入库台账：当天窗口内可修正/作废（写变更日志），跨日只能走库存调整
model InboundLedger {
  id            BigInt         @id
  entryNo       String         @unique(map: "uk_inbound_entry_no") @map("entry_no") @db.VarChar(28)
  bomId         BigInt         @map("bom_id")
  qty           Int            @db.UnsignedInt
  businessDate  DateTime       @map("business_date") @db.Date
  operatorId    BigInt         @map("operator_id")
  remark        String         @default("") @db.VarChar(500)
  status        InboundStatus  @default(ACTIVE)
  rowVersion    BigInt         @default(1) @map("row_version") @db.UnsignedBigInt
  requestKey    String         @unique(map: "uk_inbound_request") @map("request_key") @db.VarChar(128)
  updatedBy     BigInt         @map("updated_by")
  createdAt     DateTime       @map("created_at") @db.DateTime(3)
  updatedAt     DateTime       @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)
  bom               BomTable            @relation(fields: [bomId], references: [id])
  operator          SysUser             @relation("InboundOperator", fields: [operatorId], references: [id])
  updater           SysUser             @relation("InboundUpdater", fields: [updatedBy], references: [id])
  changeLogs        InboundChangeLog[]
  relatedAdjustments StockAdjustment[]

  @@index([bomId, status, businessDate, id], map: "idx_inbound_bom_status_date")
  @@map("inbound_ledger")
}

/// 入库修正/作废日志：每次变更版本 +1，before/after 全量快照
model InboundChangeLog {
  id            BigInt                @id
  inboundId     BigInt                @map("inbound_id")
  operatorId    BigInt                @map("operator_id")
  eventType     InboundChangeEventType @map("event_type")
  beforeVersion BigInt                @map("before_version") @db.UnsignedBigInt
  afterVersion  BigInt                @map("after_version") @db.UnsignedBigInt
  reason        String                @db.VarChar(500)
  requestKey    String?               @unique(map: "uk_inbound_change_request") @map("request_key") @db.VarChar(128)
  beforeJson    Json                  @map("before_json")
  afterJson     Json                  @map("after_json")
  createdAt     DateTime              @map("created_at") @db.DateTime(3)
  inbound       InboundLedger @relation(fields: [inboundId], references: [id])
  operator      SysUser       @relation("InboundChangeOperator", fields: [operatorId], references: [id])

  @@index([inboundId, createdAt(sort: Desc)], map: "idx_inbound_change_entry_time")
  @@index([operatorId, createdAt(sort: Desc)], map: "idx_inbound_change_operator_time")
  @@map("inbound_change_log")
}

/// 跨日库存调整：qty_delta 正负皆可非零；reversal_of_id 唯一键保证一次冲销
model StockAdjustment {
  id                BigInt     @id
  adjustmentNo      String     @unique(map: "uk_stock_adjustment_no") @map("adjustment_no") @db.VarChar(28)
  bomId             BigInt     @map("bom_id")
  qtyDelta          Int        @map("qty_delta")
  businessDate      DateTime   @map("business_date") @db.Date
  relatedInboundId  BigInt?    @map("related_inbound_id")
  reversalOfId      BigInt?    @unique(map: "uk_stock_adjustment_reversal_once") @map("reversal_of_id")
  operatorId        BigInt     @map("operator_id")
  reason            String     @db.VarChar(500)
  requestKey        String     @unique(map: "uk_stock_adjustment_request") @map("request_key") @db.VarChar(128)
  createdAt         DateTime   @map("created_at") @db.DateTime(3)
  bom               BomTable        @relation(fields: [bomId], references: [id])
  relatedInbound    InboundLedger?  @relation(fields: [relatedInboundId], references: [id])
  reversalOf        StockAdjustment? @relation("StockAdjustmentReversal", fields: [reversalOfId], references: [id])
  reversedBy        StockAdjustment[] @relation("StockAdjustmentReversal")
  operator          SysUser         @relation("StockAdjustmentOperator", fields: [operatorId], references: [id])

  @@index([bomId, businessDate, id], map: "idx_stock_adjustment_bom_date")
  @@index([relatedInboundId, createdAt(sort: Desc)], map: "idx_stock_adjustment_inbound")
  @@map("stock_adjustment")
}

/// 出库单：REGISTERED/VOIDED 两态；打印为无副作用纯输出（不落日志不改状态），作废是唯一逆向入口
model OutboundShipment {
  id                 BigInt               @id
  shipmentNo         String               @unique(map: "uk_outbound_shipment_no") @map("shipment_no") @db.VarChar(28)
  orderId            BigInt               @map("order_id")
  originalQty        Int                  @map("original_qty") @db.UnsignedInt
  businessDate       DateTime             @map("business_date") @db.Date
  state              OutboundShipmentState @default(REGISTERED)
  voidedBy           BigInt?              @map("voided_by")
  voidReason         String?              @map("void_reason") @db.VarChar(500)
  voidedAt           DateTime?            @map("voided_at") @db.DateTime(3)
  rowVersion         BigInt               @default(1) @map("row_version") @db.UnsignedBigInt
  requestKey         String               @unique(map: "uk_outbound_shipment_request") @map("request_key") @db.VarChar(128)
  registeredBy       BigInt               @map("registered_by")
  registeredAt       DateTime             @map("registered_at") @db.DateTime(3)
  updatedAt          DateTime             @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)
  order              SalesOrderTable   @relation(fields: [orderId], references: [id])
  registrar          SysUser           @relation("OutboundRegistrar", fields: [registeredBy], references: [id])
  voider             SysUser?          @relation("OutboundVoider", fields: [voidedBy], references: [id])
  ledgers            OutboundLedger[]
  stateLogs          OutboundStateLog[]

  @@index([orderId, state, businessDate, id], map: "idx_outbound_shipment_order_state_date")
  @@index([state, registeredAt], map: "idx_outbound_shipment_state_time")
  @@map("outbound_shipment")
}

/// 出库台账：NORMAL 正数发货 / CORRECTION 负数冲销，correction_of_id 唯一保证一次冲销
model OutboundLedger {
  id                BigInt            @id
  eventNo           String            @unique(map: "uk_outbound_event_no") @map("event_no") @db.VarChar(36)
  shipmentId        BigInt            @map("shipment_id")
  entryType         OutboundEntryType @map("entry_type")
  correctionOfId    BigInt?           @unique(map: "uk_outbound_correction_once") @map("correction_of_id")
  qtyDelta          Int               @map("qty_delta")
  businessDate      DateTime          @map("business_date") @db.Date
  operatorId        BigInt            @map("operator_id")
  remark            String            @default("") @db.VarChar(500)
  correctionReason  String?           @map("correction_reason") @db.VarChar(500)
  requestKey        String            @unique(map: "uk_outbound_request") @map("request_key") @db.VarChar(128)
  createdAt         DateTime          @map("created_at") @db.DateTime(3)
  shipment          OutboundShipment   @relation(fields: [shipmentId], references: [id])
  operator          SysUser            @relation("OutboundLedgerOperator", fields: [operatorId], references: [id])
  correctionOf      OutboundLedger?    @relation("OutboundCorrection", fields: [correctionOfId], references: [id])
  correctedBy       OutboundLedger[]   @relation("OutboundCorrection")

  @@index([shipmentId, businessDate, id], map: "idx_outbound_shipment_date")
  @@map("outbound_ledger")
}

/// 出库状态机日志：REGISTER 起版，VOID +1 版本（PRINT/REPRINT 等为迁移前存量事件）
model OutboundStateLog {
  id             BigInt                 @id
  shipmentId     BigInt                 @map("shipment_id")
  operatorId     BigInt                 @map("operator_id")
  eventType      OutboundStateEventType @map("event_type")
  beforeState    OutboundStateLogState? @map("before_state")
  afterState     OutboundStateLogState  @map("after_state")
  beforeVersion  BigInt?                @map("before_version") @db.UnsignedBigInt
  afterVersion   BigInt                 @map("after_version") @db.UnsignedBigInt
  reason         String                 @default("") @db.VarChar(500)
  requestKey     String                 @unique(map: "uk_outbound_state_request") @map("request_key") @db.VarChar(128)
  detailJson     Json                   @map("detail_json")
  createdAt      DateTime               @map("created_at") @db.DateTime(3)
  shipment       OutboundShipment @relation(fields: [shipmentId], references: [id])
  operator       SysUser          @relation("OutboundStateOperator", fields: [operatorId], references: [id])

  @@index([shipmentId, createdAt(sort: Desc)], map: "idx_outbound_state_shipment_time")
  @@index([operatorId, createdAt(sort: Desc)], map: "idx_outbound_state_operator_time")
  @@map("outbound_state_log")
}

/// 业务里程碑日志：一个目标每个动作只记一次（uk(action, target_id) 兜底）
model OpLog {
  id                   BigInt      @id
  operatorId           BigInt      @map("operator_id")
  operatorNameSnapshot String      @map("operator_name_snapshot") @db.VarChar(64)
  operatorRoleSnapshot String      @map("operator_role_snapshot") @db.VarChar(32)
  action               OpLogAction
  targetType           String      @map("target_type") @db.VarChar(32)
  targetId             BigInt      @map("target_id")
  targetCode           String      @map("target_code") @db.VarChar(64)
  detailJson           Json        @map("detail_json")
  createdAt            DateTime    @map("created_at") @db.DateTime(3)
  operator             SysUser     @relation("OpLogOperator", fields: [operatorId], references: [id])

  @@unique([action, targetId], map: "uk_op_log_action_target")
  @@index([createdAt(sort: Desc)], map: "idx_op_log_time")
  @@index([operatorId, createdAt(sort: Desc)], map: "idx_op_log_operator_time")
  @@map("op_log")
}

/// 每个订单累计已发数量（§6.2 分配算法的对照视图，SQL SECURITY INVOKER）
view VOrderOutboundQty {
  orderId     BigInt @map("order_id")
  outboundQty BigInt @map("outbound_qty")

  @@map("v_order_outbound_qty")
}

/// BOM 实时库存 = 有效入库 + 库存调整 − 出库台账（§6 视图，SQL SECURITY INVOKER）
view VBomStock {
  bomId    BigInt @map("bom_id")
  stockQty BigInt @map("stock_qty")

  @@map("v_bom_stock")
}
