# 运行环境：development / production / test
NODE_ENV=development

# HTTP 监听（生产容器需 0.0.0.0；本机调试可改 127.0.0.1）
HOST=0.0.0.0
PORT=5000

# 数据库（MySQL 8.0.16+，UTC 存储）
# 运行时与 Prisma CLI 共用这组变量，Prisma URL 由 prisma7.config.ts 自动组装，无需 DATABASE_URL
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=change-me
DB_DATABASE=zmdb

# JWT 会话（secret 至少 32 字符，可用 openssl rand -hex 32 生成）
JWT_SECRET=change-me-openssl-rand-hex-32
JWT_EXPIRES_IN=8h
JWT_ISSUER=zmsys-backend
JWT_AUDIENCE=zmsys-admin

# 雪花 id 机器位（0-1023；生产必须显式配置且全集群唯一）
SNOWFLAKE_WORKER_ID=1

# CORS 白名单（逗号分隔 origin；契约 servers 为 Vite 代理，生产按前端域名配置）
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
