# 仓库统一环境变量模板：复制为 .env 后按需修改（.env 不入库）
# backend 与 frontend 共用此文件；frontend 仅读取 VITE_ 前缀变量（其余不会进客户端包）

# ---- backend（apps/backend）----
# 运行环境：development / production / test
NODE_ENV=development

# HTTP 监听（生产容器需 0.0.0.0；本机调试可改 127.0.0.1）
HOST=0.0.0.0
PORT=5000

# 数据库（MySQL 8.0.16+，UTC 存储）
# 运行时与 Prisma CLI 共用这组变量，Prisma URL 由 prisma7.config.ts 自动组装，无需 DATABASE_URL
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=change-me
DB_DATABASE=zmdb

# JWT 会话（secret 至少 32 字符，可用 openssl rand -hex 32 生成）
JWT_SECRET=change-me-openssl-rand-hex-32
JWT_EXPIRES_IN=8h
JWT_ISSUER=zmsys-backend
JWT_AUDIENCE=zmsys-admin

# 雪花 id 机器位（0-1023；生产必须显式配置且全集群唯一）
SNOWFLAKE_WORKER_ID=1

# CORS 白名单（逗号分隔 origin；契约 servers 为 Vite 代理，生产按前端域名配置）
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- backend 演示数据 ----
# workbench 端点返回演示数据（真实聚合待接入）；生产环境开启会导致启动失败
MOCK_ENABLED=true

# ---- frontend（apps/frontend）----
# API 基础路径（dev 由 Vite 代理到 backend:5000）
VITE_API_BASE_URL=/api

# ---- backup-database（scripts/backup-database.ts）----
# 生产库备份目标；真实服务器地址写在根 .env（不入库），仓库内不留真实地址
DEPLOY_SSH_HOST=root@<server-ip>
# DEPLOY_DB_CONTAINER=admin-manage-db-1
# DEPLOY_DB_NAME=zmdb
